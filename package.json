{
  "name": "seniorqatest",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "pretest": "rm -rf cypress/results",
    "test:cli": "npx cypress run",
    "posttest": "npx mochawesome-merge 'cypress/results/*.json' > cypress/results/index.json && npx marge cypress/results/index.json -f report -o cypress/results/html",
    "test:report": "npm run pretest && npm run test:cli || npm run posttest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LucasAQA/SeniorQATest.git"
  },
  "keywords": [],
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/LucasAQA/SeniorQATest/issues"
  },
  "homepage": "https://github.com/LucasAQA/SeniorQATest#readme",
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "cypress": "^16.1.0",
    "cypress-mochawesome-reporter": "^5.0.0",
    "mochawesome": "^8.1.1",
    "mochawesome-merge": "^5.1.1",
    "mochawesome-report-generator": "^6.3.2"
  },
  "allowScripts": {
    "cypress@16.1.0": true
  }
}
